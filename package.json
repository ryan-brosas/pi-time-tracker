{
  "name": "pi-time-tracker",
  "version": "0.2.0",
  "description": "Private working-hours receipts for Pi, reconciled by a tested Bend accounting policy.",
  "license": "MIT",
  "keywords": ["pi-package"],
  "files": ["*.ts", "!*.test.ts", "*.bend", "!LAWS.bend", "!PROOF.bend", "generated/policy.mjs", "generated/policy.d.mts", "THIRD_PARTY_NOTICES.md"],
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "repository": { "type": "git", "url": "git+https://github.com/ryan-brosas/pi-time-tracker.git" },
  "bugs": { "url": "https://github.com/ryan-brosas/pi-time-tracker/issues" },
  "homepage": "https://github.com/ryan-brosas/pi-time-tracker#readme",
  "exports": { ".": "./index.ts" },
  "pi": { "extensions": ["./index.ts"] },
  "scripts": {
    "test": "bun test --timeout 90000 .",
    "check": "tsc --noEmit",
    "pack:check": "bun scripts/check-package.mjs",
    "build:bend": "bun scripts/build-bend.mjs",
    "build:check": "bun run build:bend --check",
    "proof:check": "bun test --timeout 90000 proof-gate.test.ts",
    "pack:test": "bun scripts/pack-test.mjs"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*", "typebox": "*" },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "@types/bun": "1.3.9", "semver": "7.8.5"
  }
}
